        "    file_name = list(uploaded.keys())[0]  # pick the first uploaded file\n",
        "    try:\n",
        "      df = pd.read_parquet(io.BytesIO(uploaded[file_name]))\n",
        "    except:\n",
        "      print(\"Wrong file extension. Parquet file required.\")\n",
        "    print(f\"Loaded {file_name} from manual upload.\")\n",
        "    return df"
