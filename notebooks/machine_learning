    {
      "cell_type": "code",
      "source": [
        "# Build a bootsrap function for estimating 95% confidence intervals\n",
        "def bootstrap_metrics(y_true, y_pred, y_score, n_bootstrap=5000, random_state=23):\n",
        "  rng = np.random.default_rng(random_state)\n",
        "  y_true = np.asarray(y_true)\n",
        "  y_pred = np.asarray(y_pred)\n",
        "  y_score = np.asarray(y_score)\n",
        "  n = len(y_true)\n",
        "  bootstrap_results = []\n",
        "\n",
        "  for _ in range(n_bootstrap):\n",
        "    # Resample test observations with replacement\n",
        "    idx = rng.integers(0, n, size=n)\n",
        "\n",
        "    y_true_boot = y_true[idx]\n",
        "    y_pred_boot = y_pred[idx]\n",
        "    y_score_boot = y_score[idx]\n",
        "\n",
        "    # Skip samples containing only one class\n",
        "    if len(np.unique(y_true_boot)) < 2:\n",
        "      continue\n",
        "\n",
        "    recall = recall_score(y_true_boot, y_pred_boot)\n",
        "    precision = precision_score(y_true_boot, y_pred_boot)\n",
        "    f1 = f1_score(y_true_boot, y_pred_boot)\n",
        "    pr_auc = average_precision_score(y_true_boot, y_score_boot)\n",
        "    roc_auc = roc_auc_score(y_true_boot, y_score_boot)\n",
        "\n",
        "    bootstrap_results.append([recall, precision, f1, pr_auc, roc_auc])\n",
        "\n",
        "  bootstrap_results = np.array(bootstrap_results)\n",
        "  metrics = [\"Recall\", \"Precision\", \"F1-Score\", \"PR-AUC\", \"ROC-AUC\"]\n",
        "  results = []\n",
        "\n",
        "  for i, metric in enumerate(metrics):\n",
        "    estimate = [recall_score(y_true, y_pred),\n",
        "                precision_score(y_true, y_pred, zero_division=0),\n",
        "                f1_score(y_true, y_pred),\n",
        "                average_precision_score(y_true, y_score),\n",
        "                roc_auc_score(y_true, y_score)][i]\n",
        "\n",
        "    lower = np.percentile(bootstrap_results[:, i], 2.5)\n",
        "    upper = np.percentile(bootstrap_results[:, i], 97.5)\n",
        "\n",
        "    results.append([estimate, lower, upper])\n",
        "\n",
        "  return pd.DataFrame(results, index=metrics, columns=[\"Estimate\", \"CI Lower\", \"CI Upper\"])"
      ],
